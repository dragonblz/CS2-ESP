<Window x:Class="FoxSense.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoxSense" Width="680" Height="520"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- ══ TOGGLE SWITCH (pill style) ══ -->
        <Style x:Key="ToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Background="#1A1A2E" CornerRadius="6" Padding="12,0">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Content}" Foreground="#CCCCCC"
                                           FontSize="12" FontFamily="Segoe UI"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <!-- Pill switch -->
                                <Border x:Name="pill" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="36" Height="18" CornerRadius="9" Background="#2A2A3E">
                                    <Ellipse x:Name="dot" Width="14" Height="14" Fill="#666"
                                             HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="#FF4B2B"/>
                                <Setter TargetName="dot" Property="Fill" Value="White"/>
                                <Setter TargetName="dot" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="dot" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22223A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ SIDEBAR NAV BUTTON ══ -->
        <Style x:Key="NavStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#777"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" Padding="18,0" CornerRadius="0">
                            <Grid>
                                <Border x:Name="indicator" Width="3" HorizontalAlignment="Left"
                                        Margin="-18,6,-0,6" CornerRadius="0,2,2,0"
                                        Background="Transparent"/>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0F0F22"/>
                                <Setter Property="Foreground" Value="#BBB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ SECTION HEADER ══ -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,8,0,6"/>
        </Style>

        <!-- ══ SLIDER ══ -->
        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="#FF4B2B"/>
        </Style>

        <!-- ══ SCROLLBAR ══ -->
        <Style x:Key="DarkThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#3A3A50" CornerRadius="4" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="DarkVerticalScrollBar" TargetType="ScrollBar">
            <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="true">
                    <Track.Thumb><Thumb Style="{StaticResource DarkThumb}"/></Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template" Value="{StaticResource DarkVerticalScrollBar}"/>
        </Style>

        <!-- ══ LISTBOX ══ -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0F0F22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A2A4E"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A1A38"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══ COMBOBOX ══ -->
        <ControlTemplate x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
            <Border Background="#1A1A2E" BorderBrush="#2A2A40" BorderThickness="1" CornerRadius="4" Padding="8,0">
                <Grid>
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Path Data="M0,0 L4,4 L8,0" Fill="#666"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Stroke="#666" StrokeThickness="1"/>
                </Grid>
            </Border>
        </ControlTemplate>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,3,28,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#1A1A2E" BorderBrush="#2A2A40"
                                        BorderThickness="1" CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="0,4">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#2A2A4E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ ACTION BUTTON ══ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#1A1A2E" CornerRadius="6" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <!-- ══════ OUTER BORDER ══════ -->
    <Border CornerRadius="12" Margin="6">
        <Border.Background>
            <SolidColorBrush Color="#0A0A18"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#80000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ LEFT SIDEBAR ══════ -->
            <Border Grid.Column="0" Background="#0A0A18" CornerRadius="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                        <TextBlock Text="🦊" FontSize="22" Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FOXSENSE" FontSize="14" FontFamily="Segoe UI Black"
                                       Foreground="White" Margin="0"/>
                            <TextBlock Text="v2.1" FontSize="9" Foreground="#444" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Grid.Row="1" Height="1" Background="#1A1A30" Margin="16,0"/>

                    <!-- Navigation -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button x:Name="btnNavEsp" Content="  👁  ESP" Tag="visuals"
                                Style="{StaticResource NavStyle}" Click="BtnTab_Click"/>
                        <Button x:Name="btnNavAimbot" Content="  🎯  Aimbot" Tag="aimbot"
                                Style="{StaticResource NavStyle}" Click="BtnTab_Click"/>
                        <Button x:Name="btnNavSkins" Content="  🎨  Skins" Tag="skins"
                                Style="{StaticResource NavStyle}" Click="BtnTab_Click"/>
                        <Button x:Name="btnNavSettings" Content="  ⚙  Settings" Tag="settings"
                                Style="{StaticResource NavStyle}" Click="BtnTab_Click"/>

                        <Border Height="1" Background="#1A1A30" Margin="16,10"/>

                        <TextBlock Text="  GENERAL" Style="{StaticResource SectionHeader}" Margin="18,8,0,4"/>
                        <ToggleButton x:Name="btnEnemyOnly" Content="Enemies Only" IsChecked="True"
                                      Style="{StaticResource ToggleStyle}" Margin="8,1"
                                      Checked="BtnEnemyOnly_Checked" Unchecked="BtnEnemyOnly_Unchecked"/>
                        <ToggleButton x:Name="btnShowFov" Content="Show FOV" IsChecked="True"
                                      Style="{StaticResource ToggleStyle}" Margin="8,1"/>
                    </StackPanel>

                    <!-- Status -->
                    <Border Grid.Row="4" Padding="18,0" Background="#08081A" CornerRadius="0,0,0,12">
                        <TextBlock x:Name="txtStatus" Text="⏳ Waiting..." VerticalAlignment="Center"
                                   Foreground="#444" FontSize="9"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════ RIGHT CONTENT ══════ -->
            <Border Grid.Column="1" Background="#12122A" CornerRadius="0,12,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ ESP TAB ═══ -->
                    <ScrollViewer Grid.Row="0" x:Name="panelVisuals" Margin="16,12"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="ESP SETTINGS" FontSize="14" Foreground="White"
                                       FontFamily="Segoe UI Semibold" Margin="0,0,0,10"/>

                            <ToggleButton x:Name="btnEspToggle" Content="ESP Master" IsChecked="False"
                                          Style="{StaticResource ToggleStyle}" Margin="0,2"
                                          Checked="BtnEsp_Checked" Unchecked="BtnEsp_Unchecked"/>

                            <TextBlock Text="FEATURES" Style="{StaticResource SectionHeader}"/>
                            <Border Background="#0F0F22" CornerRadius="8" Padding="8">
                                <StackPanel>
                                    <ToggleButton x:Name="btnBox" Content="📦 Box ESP" IsChecked="True"
                                                  Style="{StaticResource ToggleStyle}" Margin="0,1"/>
                                    <ToggleButton x:Name="btnSkeleton" Content="🦴 Skeleton" IsChecked="True"
                                                  Style="{StaticResource ToggleStyle}" Margin="0,1"/>
                                    <ToggleButton x:Name="btnHealthBar" Content="❤ Health Bar" IsChecked="True"
                                                  Style="{StaticResource ToggleStyle}" Margin="0,1"/>
                                    <ToggleButton x:Name="btnNames" Content="🏷 Names" IsChecked="True"
                                                  Style="{StaticResource ToggleStyle}" Margin="0,1"/>
                                    <ToggleButton x:Name="btnDistance" Content="📏 Distance" IsChecked="True"
                                                  Style="{StaticResource ToggleStyle}" Margin="0,1"/>
                                    <ToggleButton x:Name="btnSnapLines" Content="📍 Snap Lines" IsChecked="False"
                                                  Style="{StaticResource ToggleStyle}" Margin="0,1"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ESP COLOR" Style="{StaticResource SectionHeader}"/>
                            <Border Background="#0F0F22" CornerRadius="8" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="R" Grid.Row="0" Grid.Column="0" Foreground="#FF4444" FontSize="11"/>
                                    <Slider x:Name="sliderR" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255"
                                            Value="255" Style="{StaticResource SliderStyle}"/>
                                    <TextBlock Text="G" Grid.Row="1" Grid.Column="0" Foreground="#44FF44" FontSize="11"/>
                                    <Slider x:Name="sliderG" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255"
                                            Value="75" Style="{StaticResource SliderStyle}"/>
                                    <TextBlock Text="B" Grid.Row="2" Grid.Column="0" Foreground="#4444FF" FontSize="11"/>
                                    <Slider x:Name="sliderB" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255"
                                            Value="43" Style="{StaticResource SliderStyle}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═══ AIMBOT TAB ═══ -->
                    <ScrollViewer Grid.Row="0" x:Name="panelAimbot" Margin="16,12"
                                  VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="AIMBOT SETTINGS" FontSize="14" Foreground="White"
                                       FontFamily="Segoe UI Semibold" Margin="0,0,0,10"/>

                            <ToggleButton x:Name="btnAimToggle" Content="Aimbot Master" IsChecked="False"
                                          Style="{StaticResource ToggleStyle}" Margin="0,2"
                                          Checked="BtnAim_Checked" Unchecked="BtnAim_Unchecked"/>

                            <TextBlock Text="SETTINGS" Style="{StaticResource SectionHeader}"/>
                            <Border Background="#0F0F22" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="FOV Radius" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                    <Grid>
                                        <Slider x:Name="sliderFov" Minimum="20" Maximum="250" Value="80"
                                                Style="{StaticResource SliderStyle}"/>
                                        <TextBlock x:Name="txtFovValue" Text="80" HorizontalAlignment="Right"
                                                   Foreground="#FF4B2B" FontSize="11" FontFamily="Segoe UI Bold"/>
                                    </Grid>

                                    <TextBlock Text="Smoothing" Foreground="#999" FontSize="10" Margin="0,8,0,2"/>
                                    <Grid>
                                        <Slider x:Name="sliderSmooth" Minimum="1" Maximum="15" Value="5"
                                                Style="{StaticResource SliderStyle}"/>
                                        <TextBlock x:Name="txtSmoothValue" Text="5" HorizontalAlignment="Right"
                                                   Foreground="#FF4B2B" FontSize="11" FontFamily="Segoe UI Bold"/>
                                    </Grid>

                                    <TextBlock Text="Bone Target" Foreground="#999" FontSize="10" Margin="0,8,0,4"/>
                                    <ComboBox x:Name="comboBone" SelectedIndex="0" Height="28">
                                        <ComboBoxItem Content="🧠 Head"/>
                                        <ComboBoxItem Content="🦴 Neck"/>
                                        <ComboBoxItem Content="💪 Chest"/>
                                    </ComboBox>

                                    <TextBlock Text="Aim Key" Foreground="#999" FontSize="10" Margin="0,8,0,4"/>
                                    <Button x:Name="btnKeyBind" Content="🎯 Mouse1" Height="28"
                                            Style="{StaticResource ActionBtn}" Click="BtnKeyBind_Click"/>
                                </StackPanel>
                            </Border>

                            <ToggleButton x:Name="btnAimEnemyOnly" Content="Enemies Only" IsChecked="True"
                                          Style="{StaticResource ToggleStyle}" Margin="0,8,0,2"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═══ SKINS TAB ═══ -->
                    <Grid Grid.Row="0" x:Name="panelSkins" Margin="16,12" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="SKIN CHANGER" FontSize="14" Foreground="White"
                                   FontFamily="Segoe UI Semibold" Margin="0,0,0,10"/>

                        <ToggleButton Grid.Row="1" x:Name="btnSkinToggle" Content="Skin Changer" IsChecked="False"
                                      Style="{StaticResource ToggleStyle}" Margin="0,0,0,8"
                                      Checked="BtnSkin_Checked" Unchecked="BtnSkin_Unchecked"/>

                        <TextBlock Grid.Row="2" Text="SELECT WEAPON" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                        <ComboBox Grid.Row="3" x:Name="comboWeapon" Height="28" Margin="0,0,0,8"
                                  SelectionChanged="ComboWeapon_Changed"/>

                        <ListBox Grid.Row="4" x:Name="listSkins" Margin="0,0,0,8"
                                 Background="#0F0F22" BorderThickness="0"
                                 SelectionChanged="ListSkins_Changed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6" Margin="1" CornerRadius="6" Background="#14142C">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding ImageUrl}" Width="60" Height="44"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" Margin="10,2,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding RarityText}" FontSize="10"
                                                           Foreground="{Binding RarityColor}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="5" Content="🔄 Force Refresh" Height="30"
                                Style="{StaticResource ActionBtn}" Click="BtnForceRefresh_Click"/>
                    </Grid>

                    <!-- ═══ SETTINGS TAB ═══ -->
                    <ScrollViewer Grid.Row="0" x:Name="panelSettings" Margin="16,12"
                                  VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" FontSize="14" Foreground="White"
                                       FontFamily="Segoe UI Semibold" Margin="0,0,0,10"/>

                            <TextBlock Text="KEYBINDS" Style="{StaticResource SectionHeader}"/>
                            <Border Background="#0F0F22" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="GUI Toggle Key" Foreground="#999" FontSize="10" Margin="0,0,0,4"/>
                                    <Button x:Name="btnGuiKey" Content="🎮 LAlt" Height="28"
                                            Style="{StaticResource ActionBtn}" Click="BtnGuiKey_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,20,0,0" Padding="14" CornerRadius="8" Background="#0F0F22">
                                <StackPanel>
                                    <TextBlock Text="FOXSENSE v2.1" FontSize="14" Foreground="White"
                                               FontFamily="Segoe UI Black"/>
                                    <TextBlock Text="External CS2 ESP + Soft Aimbot + Skin Changer"
                                               Foreground="#777" Margin="0,4,0,0"/>
                                    <TextBlock Text="Direct Syscall Engine • Zero Hook Surface"
                                               Foreground="#444" Margin="0,2,0,0"/>
                                    <TextBlock Foreground="#333" Margin="0,10,0,0" FontSize="9"
                                               Text="Built with verified offsets"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═══ STATUS BAR ═══ -->
                    <Border Grid.Row="1" Padding="16,0" Background="#0D0D20" CornerRadius="0,0,12,0">
                        <TextBlock x:Name="txtFps" Text="" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="#333" FontSize="9"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
